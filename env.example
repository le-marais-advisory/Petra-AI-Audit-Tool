# Runtime mode
# APP_NAME=Petra Vision
# API_PREFIX=/api/v1
# ENABLE_UI=false  # Deprecated. The backend no longer mounts the legacy built-in UI.
# AUTH_ENABLED=false
# LOCAL_WORKDIR=data/tmp
# API_ALLOWED_ORIGINS=http://localhost:5173

# Microsoft Entra ID / Azure
AZURE_TENANT_ID=dce78d1e-e927-4f5a-8d06-0035eaf8cc08
AZURE_CLIENT_ID=f4cb04ea-3fd2-4d6d-83be-a08bb993f9e9
AZURE_AUDIENCE=api://f4cb04ea-3fd2-4d6d-83be-a08bb993f9e9
AZURE_REQUIRED_SCOPE=access_as_user
AZURE_ALLOWED_CLIENT_APP_IDS=fa60a728-3038-450f-ba94-8e89667048a4
AZURE_ACCEPTED_TOKEN_VERSIONS=1.0,2.0

AUTH_ENABLED=false

# Claude / Anthropic (every LLM call goes to Claude; see docs/providers.md)
# ANTHROPIC_API_KEY=
# Default models; rules can override them. Allowed models and prices: config/models.yaml
# CLAUDE_TEXT_MODEL=claude-sonnet-5-5
# CLAUDE_VISION_MODEL=           # falls back to CLAUDE_TEXT_MODEL
# Default effort: low | medium | high | xhigh | max; empty is the model default
# TEXT_RULE_EFFORT=
# VISION_RULE_EFFORT=
# ROLE_ASSIGNMENT_EFFORT=
# LAYOUT_MAPPING_EFFORT=medium
# Only sent to models that accept a non-default temperature (Sonnet 5 and 5.5 do not)
# CLAUDE_TEXT_TEMPERATURE=
# CLAUDE_VISION_TEMPERATURE=
# Token ceilings; they cover thinking as well as the answer
# CLAUDE_TEXT_MAX_TOKENS=24000
# CLAUDE_STRUCTURED_MAX_TOKENS=64000
# CLAUDE_VISION_MAX_TOKENS=16000

# Persistence is disabled by design. Uploaded PDFs are processed from temporary files and removed after analysis.

# Legacy local auth bootstrap user
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=admin
